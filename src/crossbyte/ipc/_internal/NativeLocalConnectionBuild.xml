<xml>
	<files id="crossbyte-ipc-localconnection-native">
		<depend files="hxcpp-depends"/>
		<compilerflag value="-I${this_dir}"/>
		<file name="${this_dir}/NativeLocalConnection.cpp">
			<depend name="${this_dir}/NativeLocalConnection.h"/>
		</file>
	</files>

	<target id="haxe">
		<files id="crossbyte-ipc-localconnection-native"/>
		<!-- A pipe's security descriptor and its owner: ConvertStringSecurity-
		     DescriptorToSecurityDescriptor, GetSecurityInfo and the token calls
		     live in advapi32. -->
		<lib name="advapi32.lib" if="windows"/>
	</target>
</xml>
