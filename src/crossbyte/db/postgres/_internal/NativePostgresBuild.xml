<xml>
	<files id="crossbyte-db-postgres-native">
		<depend files="hxcpp-depends"/>
		<compilerflag value="-I${this_dir}"/>
		<file name="${this_dir}/NativePostgres.cpp">
			<depend name="${this_dir}/NativePostgres.h"/>
		</file>
	</files>

	<target id="haxe">
		<files id="crossbyte-db-postgres-native"/>
		<!-- A flag, not a name: hxcpp hands <lib name> to the linker verbatim,
		     so "dl" was an input file ld went looking for ("cannot find dl"). -->
		<lib name="-ldl" if="linux"/>
	</target>
</xml>
