<xml>
	<!-- Pulls in hxcpp's own mbedTLS build. That file is `pragma once`, so
	     including it here is safe even when the program also uses sys.ssl,
	     which includes it too. This is what puts the mbedtls_pk_*,
	     mbedtls_mpi_*, and mbedtls_asn1_* symbols in the link. -->
	<include name="${HXCPP}/src/hx/libs/ssl/Build.xml"/>

	<!-- No mbedTLS version or path is pinned here. A pinned MBEDTLS_DIR
	     overrides the one hxcpp sets, and stops existing when hxcpp moves
	     on, so a clean tree cannot build.

	     hxcpp's mbedtls-flags.xml gives the include path for whichever
	     mbedTLS it ships, 2.28 or 3.6, and the configuration it builds the
	     library with, so this file and the library agree on every
	     structure's size. -->

	<files id="crossbyte-pk-native">
		<depend files="hxcpp-depends"/>
		<compilerflag value="-I${this_dir}"/>
		<include name="${HXCPP}/project/thirdparty/mbedtls-flags.xml"/>
		<file name="${this_dir}/NativePk.cpp">
			<depend name="${this_dir}/NativePk.h"/>
		</file>
	</files>

	<target id="haxe">
		<files id="crossbyte-pk-native"/>

		<!-- hxcpp_ssl is deliberately NOT listed here. The ssl Build.xml
		     included above already adds it to this same target, so naming it
		     again passes SSL.obj to the linker twice and every full link
		     warns LNK4042. -->

		<lib name="advapi32.lib" if="windows" unless="static_link"/>
		<lib name="crypt32.lib" if="windows" unless="static_link"/>
		<lib name="ws2_32.lib" if="windows" unless="static_link"/>
		<lib name="bcrypt.lib" if="windows" unless="static_link"/>
	</target>
</xml>
