<xml>
	<!--
		libsodium is compiled from vendored sources rather than linked
		from a prebuilt library, so every platform hxcpp targets gets the
		same crypto with no external dependency and nothing to install.
		This mirrors how BLAKE3 is handled, and how hxcpp itself builds
		mbedTLS, SQLite, PCRE2 and zlib.

		The architecture-specific sources (AVX2, SSSE3, AES-NI, NEON and
		so on) are safe to compile everywhere: each guards its whole body
		on HAVE_*INTRIN_H macros that libsodium's own private/common.h
		defines by compiler and target detection, so on a target without
		the instruction set they reduce to empty translation units.

		sodium/version.h is normally produced by configure; the generated
		copy upstream ships for MSVC builds is vendored alongside the
		sources. No autotools config.h is required -- no libsodium source
		includes one.

		File list generated from the vendored tree; regenerate it after
		updating libsodium rather than editing by hand.
	-->
	<set name="CROSSBYTE_SODIUM_DIR" value="${this_dir}/vendor/libsodium/src"/>

	<files id="crossbyte-sodium-vendor">
		<depend files="hxcpp-depends"/>
		<compilerflag value="-I${CROSSBYTE_SODIUM_DIR}/include"/>
		<compilerflag value="-I${CROSSBYTE_SODIUM_DIR}/include/sodium"/>

		<!-- Build the static library form; nothing here is exported from a DLL. -->
		<compilerflag value="-DSODIUM_STATIC=1"/>
		<compilerflag value="-DSODIUM_EXPORT="/>

		<!-- MSVC otherwise rejects libsodium's C99 for its own CRT warnings. -->
		<compilerflag value="-D_CRT_SECURE_NO_WARNINGS" if="windows"/>

		<file name="${CROSSBYTE_SODIUM_DIR}/crypto_aead/aegis128l/aead_aegis128l.c"/>
